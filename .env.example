# 복사해서 .env 로 사용하세요 (cp .env.example .env)

WEB_PORT=3000
DB_PORT=5432
MAILPIT_UI_PORT=8025

DB_NAME=homepage
DB_USERNAME=homepage
DB_PASSWORD=change-me

# 관리자 초기 계정 (최초 기동 시 1회 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# 샘플 뉴스 생성 여부 (뉴스 테이블이 비어있을 때만)
SEED_SAMPLE_NEWS=true

# 메일 (기본값은 docker 내 mailpit). 운영 SMTP 예시:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=help@smsoft.kr
# MAIL_PASSWORD=...
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# 465 포트(SSL) 사용 시: MAIL_PORT=465, MAIL_STARTTLS=false, MAIL_SSL=true
# MAIL_SSL=false
MAIL_HELP_ADDRESS=help@smsoft.kr
MAIL_FROM_ADDRESS=
